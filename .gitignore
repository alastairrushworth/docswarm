.cache/
# Ollama model weights live at /workspace/ollama-data on the pod, where the repo
# root *is* /workspace. Without this, every round's `git add -A` hashed tens of GB
# of weights onto the slow network volume — a ~48-min silent stall per round.
ollama-data/
.droplet_id
.droplet_ip
.pod_id
.env
__pycache__/
*.pyc
.pytest_cache/
judge/inbox/*.json
judge/feedback/*.json
data/test/predictions/
# Per-document data folders (original.pdf + transcribed.json) are supplied
# locally / mounted, not committed. Keep the split dirs via .gitkeep.
data/train/*/
data/val/*/
data/test/*/
.venv/
secrets/
logs/